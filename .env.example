
# ==========================================
# CONFIGURACIÓN GENERAL DJANGO
# ==========================================
DEBUG=True
SECRET_KEY=django-insecure-*******************

# ==========================================
# BASE DE DATOS (PostgreSQL Docker)
# ==========================================
DB_NAME=datapulse_db
DB_USER=datapulse_user
DB_PASSWORD=datapulse_password
DB_HOST=db
DB_PORT=5432

# Cadena de conexión completa (si usas dj_database_url o despliegues):
# En local (fuera de Docker):
DATABASE_URL=postgres://datapulse_user:datapulse_password@db:5432/datapulse_db

# Si ejecutas el backend DENTRO de Docker:
# DB_HOST=db
# DATABASE_URL=postgres://datapulse_user:datapulse_password@db:5432/datapulse_db

# ==========================================
# SEGURIDAD Y CORS
# ==========================================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ==========================================
# APIS EXTERNAS
# ==========================================

API_URL=https://open.er-api.com/v6/latest/USD

# Para generar esta apikey necesita registrase en https://restcountries.com/ y luego solicitarla.
API_KEY_COUNTRIES=************************


#Configuración Celery Local (Para producción condigurarlo a necesidad)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=America/Bogota
CELERY_ENABLE_UTC=False